# Copy to .env for local Docker Compose. Replace all development values before deployment.
POSTGRES_DB=apitest
POSTGRES_USER=apitest
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+asyncpg://apitest:change-this-local-password@localhost:5432/apitest
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-random-32-byte-or-longer-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
